# Copier uniquement ces valeurs dans les Secrets de l'application Streamlit.
# Ne jamais renommer ce fichier en secrets.toml dans le dépôt.

[database]
url = "postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:5432/BASE?sslmode=require"

[motsdepasse]
# Valeurs SHA-256 produites par empreinte() dans app.py.
Chloé = "REMPLACER"
Patricia = "REMPLACER"
Mika = "REMPLACER"
Quentin = "REMPLACER"
